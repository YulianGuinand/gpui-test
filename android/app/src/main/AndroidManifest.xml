<?xml version="1.0" encoding="utf-8" ?>
<!--
  AndroidManifest for the GPUI Kit messaging demo.

  A NativeActivity drives the whole lifecycle from Rust: it dlopens the
  shared library named by the `android.app.lib_name` meta-data (the
  `nativeLibraryName` manifest placeholder set in build.gradle.kts) and the
  `android-activity` crate takes over from `android_main`.

  - `configChanges`: rotation / keyboard / screen-size changes are forwarded
    to Rust instead of recreating the activity.
  - `windowSoftInputMode=adjustResize`: the keyboard resizes the surface so
    the composer stays visible.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Vulkan / GPU compositing. `required="false"` lets devices without
         Vulkan fall back to the GL ES path of wgpu. -->
    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:required="false"
        android:version="0"
    />
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:required="false"
        android:version="0x00401000"
    />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false"
    />

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/GpuiTheme"
    >

        <!-- GpuiActivity extends NativeActivity with the SplashScreen API and
             JNI bridges (nativeIsInitialized / nativeOnDeepLink) exported by
             `gpui-mobile`. -->
        <activity
            android:name="dev.gpui.mobile.GpuiActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:theme="@style/GpuiSplashTheme"
            android:windowSoftInputMode="adjustResize"
        >
            <meta-data
                android:name="android.app.lib_name"
                android:value="${nativeLibraryName}"
            />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Transparent helper activities used by the platform packages. -->
        <activity
            android:name="dev.gpui.mobile.GpuiPathPicker"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
        />
        <activity
            android:name="dev.gpui.mobile.GpuiPickerActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
        />
        <activity
            android:name="dev.gpui.mobile.GpuiPermissionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
        />
        <activity
            android:name="dev.gpui.mobile.GpuiAuthActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
        />

    </application>

</manifest>
